<!DOCTYPE html>
<html lang="id">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Login - Perpustakaan SMA N 1 Sleman</title>
  <link rel="stylesheet" href="/css/style.css">
</head>
<body class="auth-body">
  <div class="auth-card">
    <div class="auth-header">
      <img src="/img/logo-sma-n1-sleman.png" alt="Logo SMA N 1 Sleman" class="auth-logo-img">
      <h1>Perpustakaan Digital SMA N 1 Sleman</h1>
      <p>SMA Negeri 1 Sleman · Yogyakarta</p>
    </div>

    <% if (error) { %>
      <div class="alert alert-error"><%= error %></div>
    <% } %>
    <% if (message) { %>
      <div class="alert alert-success"><%= message %></div>
    <% } %>

    <div class="role-tabs">
      <button type="button" class="role-tab active" data-role="siswa">Siswa</button>
      <button type="button" class="role-tab" data-role="petugas">Petugas</button>
      <button type="button" class="role-tab" data-role="admin">Admin</button>
    </div>

    <form action="/login" method="POST" class="auth-form">
      <input type="hidden" name="role" id="role-input" value="siswa">
      <div class="form-group">
        <label for="username">Username</label>
        <input type="text" id="username" name="username" required placeholder="Masukkan username">
      </div>
      <div class="form-group">
        <label for="password">Password</label>
        <input type="password" id="password" name="password" required placeholder="Masukkan password">
      </div>
      <button type="submit" class="btn btn-primary btn-block">Login</button>
    </form>

    <p class="auth-footer">
      Belum menjadi anggota?
      <a href="/register">Daftar di sini</a>
    </p>
  </div>

  <script>
    const roleInput = document.getElementById('role-input');
    document.querySelectorAll('.role-tab').forEach((tab) => {
      tab.addEventListener('click', () => {
        document.querySelectorAll('.role-tab').forEach((t) => t.classList.remove('active'));
        tab.classList.add('active');
        roleInput.value = tab.dataset.role;
      });
    });
  </script>
</body>
</html>
