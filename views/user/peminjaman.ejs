<!DOCTYPE html>
<html lang="id">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title><%= title %> - Perpustakaan SMA N 1 Sleman</title>
  <link rel="stylesheet" href="/css/style.css">
  <script src="/js/fake-cover.js" defer></script>
</head>
<body>
  <div class="layout">
    <aside class="sidebar">
      <div class="sidebar-brand"><img src="/img/logo-sma-n1-sleman.png" alt="Logo SMA N 1 Sleman" class="sidebar-logo"><span>Perpus SMA N 1 Sleman</span></div>
      <nav class="sidebar-nav">
        <a href="/user/dashboard" class="nav-link">Dashboard</a>
        <a href="/user/katalog" class="nav-link">Katalog Buku</a>
        <a href="/user/peminjaman" class="nav-link active">Peminjaman</a>
        <a href="/user/pengembalian" class="nav-link">Pengembalian</a>
        <a href="/user/denda" class="nav-link">Denda & Pembayaran</a>
        <a href="/user/riwayat" class="nav-link">Riwayat</a>
        <a href="/user/bantuan" class="nav-link">Bantuan</a>
      </nav>
      <div class="sidebar-user">
        <span class="sidebar-user-role">Siswa</span>
        <span class="sidebar-user-name"><%= currentUser.username %></span>
        <form action="/logout" method="POST">
          <button type="submit" class="btn btn-outline btn-sm">Logout</button>
        </form>
      </div>
    </aside>

    <main class="main">
      <header class="topbar">
        <h1>Peminjaman Buku</h1>
        <span class="badge badge-siswa">Siswa</span>
      </header>

      <div class="content">
        <% if (message) { %>
          <div class="alert alert-success alert-dismissible">
            <%= message %>
            <button class="alert-close" onclick="this.parentElement.style.display='none'">&times;</button>
          </div>
        <% } %>
        <% if (error) { %>
          <div class="alert alert-error alert-dismissible">
            <%= error %>
            <button class="alert-close" onclick="this.parentElement.style.display='none'">&times;</button>
          </div>
        <% } %>

        <div class="card">
          <div class="card-header">
            <h2>Cari Buku untuk Dipinjam</h2>
            <form action="/user/peminjaman" method="GET" class="search-form">
              <input type="text" name="search" value="<%= search %>" placeholder="Cari judul/kategori/penulis/isbn...">
              <select name="kategori" class="filter-select">
                <option value="">Semua Kategori</option>
                <% kategoriList.forEach((k) => { %>
                  <option value="<%= k %>" <%= kategori === k ? 'selected' : '' %>><%= k %></option>
                <% }) %>
              </select>
              <button type="submit" class="btn btn-outline">Cari</button>
              <% if (search || kategori) { %>
                <a href="/user/peminjaman" class="btn btn-outline btn-sm">Reset</a>
              <% } %>
            </form>
          </div>

          <% if (buku.length === 0) { %>
            <p class="text-muted">Tidak ada buku yang tersedia untuk dipinjam.</p>
          <% } else { %>
            <div class="book-grid">
              <% buku.forEach((b) => { %>
                <div class="book-card">
                  <div class="book-cover">
                    <% if (b.cover_url) { %>
                      <img src="<%= b.cover_url %>" alt="<%= b.judul %>" class="cover-img"
                        data-fake-cover-fallback data-judul="<%= b.judul %>" data-penulis="<%= b.penulis %>" data-kategori="<%= b.kategori %>">
                    <% } else { %>
                      <div class="cover-emoji" data-fake-cover data-judul="<%= b.judul %>" data-penulis="<%= b.penulis %>" data-kategori="<%= b.kategori %>"></div>
                    <% } %>
                  </div>
                  <div class="book-info">
                    <h3 class="book-title"><%= b.judul %></h3>
                    <p class="book-author"><%= b.penulis %></p>
                    <div class="stars">
                      <% const rounded = Math.round((b.rating || 0)); %>
                      <% for (let s = 1; s <= 5; s++) { %>
                        <span class="star <%= s <= rounded ? 'star-on' : 'star-off' %>">★</span>
                      <% } %>
                      <span class="stars-text"><%= (b.rating || 0).toFixed(1) %></span>
                    </div>
                    <% if (b.deskripsi) { %>
                      <p class="book-desc"><%= b.deskripsi.length > 90 ? b.deskripsi.slice(0, 90) + '...' : b.deskripsi %></p>
                    <% } %>
                    <p class="book-meta">
                      <span class="badge"><%= b.kategori %></span>
                      <span class="badge <%= b.stok > 0 ? 'badge-success' : 'badge-danger' %>">
                        Stok: <%= b.stok %>
                      </span>
                    </p>
                  </div>
                  <div class="book-actions">
                    <a href="/user/buku/<%= b.id %>" class="btn btn-outline btn-sm btn-block" style="margin-bottom:6px;">Detail & Rating</a>
                    <% if (b.stok > 0 && !pinjamIds.has(b.id)) { %>
                      <form action="/user/peminjaman" method="POST" class="pinjam-form">
                        <input type="hidden" name="id_buku" value="<%= b.id %>">
                        <div class="durasi-row">
                          <label class="durasi-label">Durasi (hari)</label>
                          <select name="durasi" class="durasi-select" required>
                            <% for (let d = 1; d <= 30; d++) { %>
                              <option value="<%= d %>" <%= d === 7 ? 'selected' : '' %>><%= d %> hari</option>
                            <% } %>
                          </select>
                        </div>
                        <button type="submit" class="btn btn-primary btn-sm btn-block">Pinjam</button>
                      </form>
                    <% } else if (pinjamIds.has(b.id)) { %>
                      <span class="badge badge-danger">Sedang Dipinjam</span>
                    <% } else { %>
                      <span class="badge badge-danger">Stok Habis</span>
                    <% } %>
                  </div>
                </div>
              <% }) %>
            </div>
            <% if (search || kategori) { %>
              <p class="text-muted"><%= buku.length %> hasil ditemukan</p>
            <% } %>
          <% } %>
        </div>
      </div>
    </main>
  </div>
</body>
</html>
