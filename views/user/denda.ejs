<!DOCTYPE html>
<html lang="id">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title><%= title %> - Perpustakaan SMA N 1 Sleman</title>
  <link rel="stylesheet" href="/css/style.css">
  <script src="/js/fake-cover.js" defer></script>
</head>
<body>
  <div class="layout">
    <aside class="sidebar">
      <div class="sidebar-brand"><img src="/img/logo-sma-n1-sleman.png" alt="Logo SMA N 1 Sleman" class="sidebar-logo"><span>Perpus SMA N 1 Sleman</span></div>
      <nav class="sidebar-nav">
        <a href="/user/dashboard" class="nav-link">Dashboard</a>
        <a href="/user/katalog" class="nav-link">Katalog Buku</a>
        <a href="/user/peminjaman" class="nav-link">Peminjaman</a>
        <a href="/user/pengembalian" class="nav-link">Pengembalian</a>
        <a href="/user/denda" class="nav-link active">Denda & Pembayaran</a>
        <a href="/user/riwayat" class="nav-link">Riwayat</a>
        <a href="/user/bantuan" class="nav-link">Bantuan</a>
      </nav>
      <div class="sidebar-user">
        <span class="sidebar-user-role">Siswa</span>
        <span class="sidebar-user-name"><%= currentUser.username %></span>
        <form action="/logout" method="POST">
          <button type="submit" class="btn btn-outline btn-sm">Logout</button>
        </form>
      </div>
    </aside>

    <main class="main">
      <header class="topbar">
        <h1>Denda Saya</h1>
        <span class="badge badge-siswa">Siswa</span>
      </header>

      <div class="content">
        <% if (message) { %>
          <div class="alert alert-success alert-dismissible">
            <%= message %>
            <button class="alert-close" onclick="this.parentElement.style.display='none'">&times;</button>
          </div>
        <% } %>
        <% if (error) { %>
          <div class="alert alert-error alert-dismissible">
            <%= error %>
            <button class="alert-close" onclick="this.parentElement.style.display='none'">&times;</button>
          </div>
        <% } %>

        <div class="denda-total card">
          <div class="denda-total-label">Total Denda Belum Dibayar</div>
          <div class="denda-total-value" id="denda-total"><%= (typeof totalBelumBayar !== 'undefined' ? totalBelumBayar : 0).toLocaleString('id-ID') %></div>
          <div class="denda-total-currency">Rupiah (Rp)</div>
        </div>

        <div class="card">
          <div class="card-header">
            <h2>Riwayat Denda</h2>
          </div>
          <div class="table-responsive">
            <table class="table denda-table" data-total="<%= (typeof totalBelumBayar !== 'undefined' ? totalBelumBayar : 0) %>">
              <thead>
                <tr>
                  <th>No</th>
                  <th>Buku</th>
                  <th>Jenis</th>
                  <th>Jumlah</th>
                  <th>Status</th>
                  <th>Aksi</th>
                </tr>
              </thead>
              <tbody>
                <% if (denda.length === 0) { %>
                  <tr><td colspan="6" class="empty">Tidak ada denda. Pertahankan ya! 😄</td></tr>
                <% } else { %>
                  <% denda.forEach((d, i) => { %>
                  <tr>
                    <td><%= i + 1 %></td>
                    <td>
                      <div class="denda-buku">
                        <% if (d.buku) { %>
                          <% if (d.buku.cover_url) { %>
                            <img src="<%= d.buku.cover_url %>" alt="<%= d.buku.judul %>" class="cover-thumb"
                              data-fake-cover-fallback data-judul="<%= d.buku.judul %>" data-penulis="<%= d.buku.penulis || '' %>" data-kategori="<%= d.buku.kategori || '' %>">
                          <% } else { %>
                            <div class="cover-thumb" data-fake-cover data-judul="<%= d.buku.judul %>" data-penulis="<%= d.buku.penulis || '' %>" data-kategori="<%= d.buku.kategori || '' %>"></div>
                          <% } %>
                        <% } %>
                        <%= d.buku ? d.buku.judul : '-' %>
                      </div>
                    </td>
                    <td>
                      <span class="badge <%= d.jenis === 'telat' ? 'badge-warning' : 'badge-danger' %>">
                        <%= d.jenis === 'telat' ? 'Telat ' + d.hari_keterlambatan + ' hari' : 'Rusak/Hilang' %>
                      </span>
                    </td>
                    <td class="text-bold">Rp <%= d.jumlah.toLocaleString('id-ID') %></td>
                    <td>
                      <span class="badge <%= d.status === 'lunas' ? 'badge-success' : 'badge-danger' %>">
                        <%= d.status === 'lunas' ? 'Lunas' : 'Belum Bayar' %>
                      </span>
                    </td>
                    <td>
                      <% if (d.status === 'belum_bayar') { %>
                        <a href="/user/denda/<%= d.id %>/bayar" class="btn btn-primary btn-sm">Bayar</a>
                      <% } else { %>
                        <span class="text-success">✓ Paid</span>
                      <% } %>
                    </td>
                  </tr>
                  <% }) %>
                <% } %>
              </tbody>
            </table>
          </div>
        </div>
      </div>
    </main>
  </div>
</body>
</html>