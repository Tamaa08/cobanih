<!DOCTYPE html>
<html lang="id">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Laporan Transaksi - Perpustakaan SMA N 1 Sleman</title>
  <style>
    * { box-sizing: border-box; }
    body { font-family: Arial, sans-serif; color: #111; margin: 0; padding: 24px; }
    .no-print { margin-bottom: 16px; }
    .btn { padding: 8px 14px; border: none; border-radius: 6px; background: #1e3f73; color: #fff;
           font-size: 13px; font-weight: 600; cursor: pointer; }
    .header { text-align: center; margin-bottom: 20px; }
    .header h1 { margin: 0; font-size: 19px; }
    .header p { margin: 3px 0; font-size: 12px; color: #444; }
    .meta { margin-bottom: 14px; font-size: 12px; }
    table { width: 100%; border-collapse: collapse; font-size: 11px; }
    th, td { border: 1px solid #555; padding: 5px 7px; text-align: left; }
    th { background: #eef2f8; }
    .summary { display: flex; gap: 26px; margin-bottom: 12px; font-size: 12px; font-weight: 600; }
    .ttd { margin-top: 60px; display: flex; justify-content: space-between; font-size: 13px; }
    .ttd div { text-align: center; width: 45%; }
    .ttd .space { margin-top: 70px; }
    @media print {
      @page { size: landscape; margin: 12mm; }
      .no-print { display: none; }
      body { padding: 0; }
    }
  </style>
</head>
<body>
  <div class="no-print">
    <button class="btn" onclick="window.print()">🖨️ Cetak</button>
    <button class="btn" onclick="window.close()">Tutup</button>
  </div>

  <div class="header">
    <h1>PERPUSTAKAAN SMA N 1 SLEMAN</h1>
    <p>SMA Negeri 1 Sleman · Jl. Kemasan No. 36, Triharjo, Sleman, Yogyakarta</p>
    <h2 style="margin:8px 0 4px; font-size:15px;">LAPORAN PEMINJAMAN BUKU</h2>
  </div>

  <div class="meta">
    Periode: <%= mulai %> s/d <%= selesai %> &nbsp;|&nbsp; Status: <%= statusLabel %> &nbsp;|&nbsp;
    Dicetak: <%= tanggalCetak %>
  </div>

  <div class="summary">
    <span>Total Transaksi: <%= total %></span>
    <span>Sedang Dipinjam: <%= dipinjam %></span>
    <span>Sudah Dikembalikan: <%= dikembalikan %></span>
    <span>Total Denda: Rp <%= totalDenda.toLocaleString('id-ID') %></span>
  </div>

  <table>
    <thead>
      <tr>
        <th>No</th>
        <th>Tgl Pinjam</th>
        <th>Jatuh Tempo</th>
        <th>Tgl Kembali</th>
        <th>Peminjam</th>
        <th>Kelas / NIS</th>
        <th>Buku</th>
        <th>Status</th>
        <th>Denda</th>
      </tr>
    </thead>
    <tbody>
      <% if (data.length === 0) { %>
        <tr><td colspan="9" style="text-align:center;">Tidak ada data transaksi pada periode/filter ini.</td></tr>
      <% } else { %>
        <% data.forEach((t, i) => { %>
        <tr>
          <td><%= i + 1 %></td>
          <td><%= new Date(t.tanggal_pinjam).toLocaleDateString('id-ID') %></td>
          <td><%= new Date(t.tanggal_kembali).toLocaleDateString('id-ID') %></td>
          <td><%= t.tanggal_kembali_aktual ? new Date(t.tanggal_kembali_aktual).toLocaleDateString('id-ID') : '-' %></td>
          <td><%= t.anggota ? t.anggota.nama : '-' %></td>
          <td><%= t.anggota ? (t.anggota.kelas + ' / NIS ' + t.anggota.nis) : '-' %></td>
          <td><%= t.buku ? t.buku.judul : '-' %></td>
          <td><%= t.status %></td>
          <td><%= ['dipinjam', 'dikembalikan'].includes(t.status) ? ('Rp ' + t.denda_total) : '-' %></td>
        </tr>
        <% }) %>
      <% } %>
    </tbody>
  </table>

  <div class="ttd">
    <div>
      <p>Mengetahui,<br>Kepala Perpustakaan</p>
      <div class="space"></div>
      <p>( ______________________ )</p>
    </div>
    <div>
      <p>Sleman, <%= tanggalCetak %></p>
      <div class="space"></div>
      <p>( ______________________ )</p>
    </div>
  </div>

  <script>
    window.onload = () => {
      if (document.querySelectorAll('tbody tr').length <= 1) return;
    };
  </script>
</body>
</html>