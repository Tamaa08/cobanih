<!DOCTYPE html>
<html lang="id">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title><%= title %> - Perpustakaan SMA N 1 Sleman</title>
  <link rel="stylesheet" href="/css/style.css">
</head>
<body>
  <div class="layout">
    <aside class="sidebar">
      <div class="sidebar-brand"><img src="/img/logo-sma-n1-sleman.png" alt="Logo SMA N 1 Sleman" class="sidebar-logo"><span>Perpus SMA N 1 Sleman</span></div>
      <nav class="sidebar-nav">
        <% if (currentUser.role === 'admin') { %>
        <a href="/admin/akun" class="nav-link">Kelola Akun</a>
        <% } %>
        <a href="/admin/dashboard" class="nav-link">Dashboard</a>
        <a href="/admin/buku" class="nav-link">Kelola Data Buku</a>
        <a href="/admin/anggota" class="nav-link">Kelola Anggota</a>
        <a href="/admin/transaksi" class="nav-link active">Transaksi</a>
        <a href="/admin/denda" class="nav-link">Denda</a>
        <a href="/admin/statistik" class="nav-link">Statistik & Grafik</a>
        <a href="/admin/bantuan" class="nav-link">Bantuan</a>
<a href="/admin/laporan" class="nav-link">Laporan</a><a href="/admin/pengaturan" class="nav-link">Pengaturan</a>
      </nav>
      <div class="sidebar-user">
        <span class="sidebar-user-role"><%= currentUser.role === 'petugas' ? 'Petugas Perpustakaan' : 'Admin' %></span>
        <span class="sidebar-user-name"><%= currentUser.username %></span>
        <form action="/logout" method="POST">
          <button type="submit" class="btn btn-outline btn-sm">Logout</button>
        </form>
      </div>
    </aside>

    <main class="main">
      <header class="topbar">
        <h1>Edit Transaksi</h1>
        <span class="badge <%= currentUser.role === 'petugas' ? 'badge-petugas' : 'badge-admin' %>"><%= currentUser.role === 'petugas' ? 'Petugas' : 'Admin' %></span>
      </header>

      <div class="content">
        <% if (error) { %>
          <div class="alert alert-error"><%= error %></div>
        <% } %>

        <div class="card">
          <div class="card-header">
            <h2>Ubah Data Transaksi</h2>
            <a href="/admin/transaksi" class="btn btn-outline btn-sm">← Kembali</a>
          </div>
          <form action="/admin/transaksi/<%= trx.id %>/edit" method="POST" class="form-grid">
            <div class="form-group">
              <label>Buku</label>
              <input type="text" value="<%= trx.buku ? trx.buku.judul : '-' %>" disabled>
            </div>
            <div class="form-group">
              <label>Anggota</label>
              <input type="text" value="<%= trx.anggota ? trx.anggota.nama : '-' %>" disabled>
            </div>
            <div class="form-group">
              <label>Tanggal Pinjam</label>
              <input type="date" name="tanggal_pinjam" value="<%= new Date(trx.tanggal_pinjam).toISOString().slice(0,10) %>" required>
            </div>
            <div class="form-group">
              <label>Jatuh Tempo</label>
              <input type="date" name="tanggal_kembali" value="<%= new Date(trx.tanggal_kembali).toISOString().slice(0,10) %>" required>
            </div>
            <% if (trx.status === 'dikembalikan') { %>
              <div class="form-group">
                <label>Tanggal Dikembalikan</label>
                <input type="date" name="tanggal_kembali_aktual" value="<%= trx.tanggal_kembali_aktual ? new Date(trx.tanggal_kembali_aktual).toISOString().slice(0,10) : '' %>">
              </div>
            <% } %>
            <div class="form-group">
              <label>Status</label>
              <select name="status">
                <option value="dipinjam" <%= trx.status === 'dipinjam' ? 'selected' : '' %>>Dipinjam</option>
                <option value="dikembalikan" <%= trx.status === 'dikembalikan' ? 'selected' : '' %>>Dikembalikan</option>
              </select>
            </div>
            <div class="form-group form-group-full">
              <button type="submit" class="btn btn-primary">Simpan Perubahan</button>
            </div>
          </form>
        </div>
      </div>
    </main>
  </div>
</body>
</html>