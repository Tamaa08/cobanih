<!DOCTYPE html>
<html lang="id">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title><%= title %> - Perpustakaan Sekolah</title>
  <link rel="stylesheet" href="/css/style.css">
</head>
<body>
  <div class="layout">
    <aside class="sidebar">
      <div class="sidebar-brand">📚 Perpus Digital</div>
      <nav class="sidebar-nav">
        <a href="/admin/dashboard" class="nav-link">Dashboard</a>
        <a href="/admin/buku" class="nav-link active">Kelola Data Buku</a>
        <a href="/admin/anggota" class="nav-link">Kelola Anggota</a>
        <a href="/admin/transaksi" class="nav-link">Transaksi</a>
        <a href="/admin/laporan" class="nav-link">Laporan</a>
      </nav>
      <div class="sidebar-user">
        <span class="sidebar-user-role">Admin</span>
        <span class="sidebar-user-name"><%= currentUser.username %></span>
        <form action="/logout" method="POST">
          <button type="submit" class="btn btn-outline btn-sm">Logout</button>
        </form>
      </div>
    </aside>

    <main class="main">
      <header class="topbar">
        <h1><%= title %></h1>
        <span class="badge badge-admin">Admin</span>
      </header>

      <div class="content">
        <% if (message) { %>
          <div class="alert alert-success alert-dismissible">
            <%= message %>
            <button class="alert-close" onclick="this.parentElement.style.display='none'">&times;</button>
          </div>
        <% } %>
        <% if (error) { %>
          <div class="alert alert-error alert-dismissible">
            <%= error %>
            <button class="alert-close" onclick="this.parentElement.style.display='none'">&times;</button>
          </div>
        <% } %>

        <div class="card">
          <div class="card-header">
            <h2>Tambah Buku Baru</h2>
          </div>
          <form action="/admin/buku" method="POST" enctype="multipart/form-data" class="form-grid">
            <div class="form-group">
              <label>Judul Buku</label>
              <input type="text" name="judul" required>
            </div>
            <div class="form-group">
              <label>Penulis</label>
              <input type="text" name="penulis" required>
            </div>
            <div class="form-group">
              <label>Penerbit</label>
              <input type="text" name="penerbit">
            </div>
            <div class="form-group">
              <label>Tahun Terbit</label>
              <input type="number" name="tahun_terbit" min="1900" max="2100">
            </div>
            <div class="form-group">
              <label>Kategori</label>
              <input type="text" name="kategori" required placeholder="Mis. Fiksi, Sains">
            </div>
            <div class="form-group">
              <label>Stok</label>
              <input type="number" name="stok" min="0" required>
            </div>
            <div class="form-group form-group-full">
              <label>Lokasi Rak</label>
              <input type="text" name="lokasi" placeholder="Mis. Rak A-1">
            </div>
            <div class="form-group form-group-full">
              <label>Sampul Buku (opsional, JPG/PNG/WebP/GIF, max 5MB)</label>
              <input type="file" name="cover" accept="image/jpeg,image/png,image/webp,image/gif">
            </div>
            <div class="form-group form-group-full">
              <button type="submit" class="btn btn-primary">Tambah Buku</button>
            </div>
          </form>
        </div>

        <div class="card">
          <div class="card-header">
            <h2>Daftar Buku</h2>
            <form action="/admin/buku" method="GET" class="search-form">
              <input type="text" name="search" value="<%= search %>" placeholder="Cari judul/kategori/penulis...">
              <button type="submit" class="btn btn-outline">Cari</button>
              <% if (search) { %>
                <a href="/admin/buku" class="btn btn-outline btn-sm">Reset</a>
              <% } %>
            </form>
          </div>
          <div class="table-responsive">
            <table class="table">
              <thead>
                <tr>
                  <th>No</th>
                  <th>Sampul</th>
                  <th>Judul</th>
                  <th>Penulis</th>
                  <th>Kategori</th>
                  <th>Stok</th>
                  <th>Lokasi</th>
                  <th>Aksi</th>
                </tr>
              </thead>
              <tbody>
                <% if (buku.length === 0) { %>
                  <tr><td colspan="8" class="empty">Tidak ada buku ditemukan</td></tr>
                <% } else { %>
                  <% buku.forEach((b, i) => { %>
                  <tr>
                    <td><%= i + 1 %></td>
                    <td>
                      <% if (b.cover_url) { %>
                        <img src="<%= b.cover_url %>" alt="<%= b.judul %>" class="cover-thumb">
                      <% } else { %>
                        <span class="cover-placeholder">📖</span>
                      <% } %>
                    </td>
                    <td><strong><%= b.judul %></strong></td>
                    <td><%= b.penulis %></td>
                    <td><%= b.kategori %></td>
                    <td><%= b.stok %></td>
                    <td><%= b.lokasi || '-' %></td>
                    <td class="actions">
                      <a href="/admin/buku/<%= b.id %>/edit" class="btn btn-warning btn-sm">Edit</a>
                      <form action="/admin/buku/<%= b.id %>/delete" method="POST" onsubmit="return confirm('Yakin hapus buku ini?')">
                        <button type="submit" class="btn btn-danger btn-sm">Hapus</button>
                      </form>
                    </td>
                  </tr>
                  <% }) %>
                <% } %>
              </tbody>
            </table>
          </div>
          <% if (search) { %>
            <p class="text-muted"><%= buku.length %> hasil ditemukan untuk "<%= search %>"</p>
          <% } %>
        </div>
      </div>
    </main>
  </div>
</body>
</html>
