<!DOCTYPE html>
<html lang="id">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title><%= title %> - Perpustakaan SMA N 1 Sleman</title>
  <link rel="stylesheet" href="/css/style.css">
  <script src="/js/fake-cover.js" defer></script>
  <script src="/js/cover-preview.js" defer></script>
</head>
<body>
  <div class="layout">
    <aside class="sidebar">
      <div class="sidebar-brand">📚 Perpus SMA N 1 Sleman</div>
      <nav class="sidebar-nav">
        <% if (currentUser.role === 'admin') { %>
        <a href="/admin/akun" class="nav-link">Kelola Akun</a>
        <% } %>
        <a href="/admin/dashboard" class="nav-link">Dashboard</a>
        <a href="/admin/buku" class="nav-link active">Kelola Data Buku</a>
        <a href="/admin/anggota" class="nav-link">Kelola Anggota</a>
        <a href="/admin/transaksi" class="nav-link">Transaksi</a>
        <a href="/admin/denda" class="nav-link">Denda</a>
        <a href="/admin/statistik" class="nav-link">Statistik & Grafik</a>
        <a href="/admin/laporan" class="nav-link">Laporan</a>
      </nav>
      <div class="sidebar-user">
        <span class="sidebar-user-role"><%= currentUser.role === 'petugas' ? 'Petugas Perpustakaan' : 'Admin' %></span>
        <span class="sidebar-user-name"><%= currentUser.username %></span>
        <form action="/logout" method="POST">
          <button type="submit" class="btn btn-outline btn-sm">Logout</button>
        </form>
      </div>
    </aside>

    <main class="main">
      <header class="topbar">
        <h1><%= title %></h1>
        <span class="badge <%= currentUser.role === 'petugas' ? 'badge-petugas' : 'badge-admin' %>"><%= currentUser.role === 'petugas' ? 'Petugas' : 'Admin' %></span>
      </header>

      <div class="content">
        <% if (message) { %>
          <div class="alert alert-success alert-dismissible">
            <%= message %>
            <button class="alert-close" onclick="this.parentElement.style.display='none'">&times;</button>
          </div>
        <% } %>
        <% if (error) { %>
          <div class="alert alert-error alert-dismissible">
            <%= error %>
            <button class="alert-close" onclick="this.parentElement.style.display='none'">&times;</button>
          </div>
        <% } %>

        <div class="card">
          <div class="card-header">
            <h2>Tambah Buku Baru</h2>
          </div>
          <form action="/admin/buku" method="POST" class="form-grid">
            <div class="form-group">
              <label>Judul Buku</label>
              <input type="text" name="judul" required>
            </div>
            <div class="form-group">
              <label>Penulis</label>
              <input type="text" name="penulis" required>
            </div>
            <div class="form-group">
              <label>Penerbit</label>
              <input type="text" name="penerbit">
            </div>
            <div class="form-group">
              <label>Tahun Terbit</label>
              <input type="number" name="tahun_terbit" min="1900" max="2100">
            </div>
            <div class="form-group">
              <label>Kategori</label>
              <input type="text" name="kategori" required placeholder="Mis. Fiksi, Sains">
            </div>
            <div class="form-group">
              <label>ISBN</label>
              <input type="text" name="isbn" placeholder="Mis. 978-979-3062-92-1">
            </div>
            <div class="form-group">
              <label>Stok</label>
              <input type="number" name="stok" min="0" required>
            </div>
            <div class="form-group">
              <label>Kualitas / Kondisi</label>
              <select name="kualitas">
                <option value="">- Pilih -</option>
                <option value="Baru">Baru</option>
                <option value="Baik">Baik</option>
                <option value="Cukup">Cukup</option>
                <option value="Rusak">Rusak</option>
              </select>
            </div>
            <div class="form-group form-group-full">
              <label>Lokasi Rak</label>
              <input type="text" name="lokasi" placeholder="Mis. Rak A-1">
            </div>
            <div class="form-group form-group-full">
              <label>URL Sampul Buku (opsional — tempel <strong>link langsung ke gambar</strong>, mis. dari imgbb.com)</label>
              <input type="url" name="cover_url" id="cover-url-input" placeholder="https://contoh.com/sampul.jpg">
              <div class="cover-current">Pratinjau:</div>
              <img id="cover-live-preview" src="" alt="Pratinjau sampul" class="cover-preview" data-live-cover-preview style="display:none">
              <div id="cover-no-preview" class="cover-preview" data-fake-cover></div>
            </div>
            <div class="form-group">
              <label>Rating Awal (0-5, opsional)</label>
              <input type="number" name="rating" min="0" max="5" step="0.1" placeholder="Mis. 4.5">
            </div>
            <div class="form-group">
              <label>Deskripsi / Inti Buku</label>
              <input type="text" name="deskripsi" placeholder="Singkat, jelaskan inti buku">
            </div>
            <div class="form-group form-group-full">
              <button type="submit" class="btn btn-primary">Tambah Buku</button>
            </div>
          </form>
        </div>

        <div class="card">
          <div class="card-header">
            <h2>Daftar Buku</h2>
            <form action="/admin/buku" method="GET" class="search-form">
              <input type="text" name="search" value="<%= search %>" placeholder="Cari judul/kategori/penulis/isbn...">
              <select name="kategori" class="filter-select">
                <option value="">Semua Kategori</option>
                <% kategoriList.forEach((k) => { %>
                  <option value="<%= k %>" <%= kategori === k ? 'selected' : '' %>><%= k %></option>
                <% }) %>
              </select>
              <button type="submit" class="btn btn-outline">Cari</button>
              <% if (search || kategori) { %>
                <a href="/admin/buku" class="btn btn-outline btn-sm">Reset</a>
              <% } %>
            </form>
          </div>
          <div class="table-responsive">
            <table class="table">
              <thead>
                <tr>
                  <th>No</th>
                  <th>Sampul</th>
                  <th>Judul</th>
                  <th>ISBN</th>
                  <th>Kategori</th>
                  <th>Rating</th>
                  <th>Kualitas</th>
                  <th>Deskripsi</th>
                  <th>Stok</th>
                  <th>Aksi</th>
                </tr>
              </thead>
              <tbody>
                <% if (buku.length === 0) { %>
                  <tr><td colspan="10" class="empty">Tidak ada buku ditemukan</td></tr>
                <% } else { %>
                  <% buku.forEach((b, i) => { %>
                  <tr>
                    <td><%= i + 1 %></td>
                    <td>
                      <% if (b.cover_url) { %>
                        <img src="<%= b.cover_url %>" alt="<%= b.judul %>" class="cover-thumb"
                          data-fake-cover-fallback data-judul="<%= b.judul %>" data-penulis="<%= b.penulis %>" data-kategori="<%= b.kategori %>">
                      <% } else { %>
                        <div class="cover-placeholder cover-thumb" data-fake-cover data-judul="<%= b.judul %>" data-penulis="<%= b.penulis %>" data-kategori="<%= b.kategori %>"></div>
                      <% } %>
                    </td>
                    <td><strong><%= b.judul %></strong><br><small class="text-muted"><%= b.penulis %></small></td>
                    <td><%= b.isbn || '-' %></td>
                    <td><%= b.kategori %></td>
                    <td>
                      <div class="stars">
                        <% const rounded = Math.round((b.rating || 0)); %>
                        <% for (let s = 1; s <= 5; s++) { %>
                          <span class="star <%= s <= rounded ? 'star-on' : 'star-off' %>">★</span>
                        <% } %>
                        <span class="stars-text"><%= (b.rating || 0).toFixed(1) %> (<%= b.rating_count || 0 %>)</span>
                      </div>
                    </td>
                    <td>
                      <span class="badge-buku-kualitas <%= 'kualitas-' + (b.kualitas || '').toLowerCase() %>"><%= b.kualitas || '-' %></span>
                    </td>
                    <td class="desc-cell"><%= b.deskripsi || '-' %></td>
                    <td><%= b.stok %></td>
                    <td class="actions">
                      <a href="/admin/buku/<%= b.id %>/edit" class="btn btn-warning btn-sm">Edit</a>
                      <form action="/admin/buku/<%= b.id %>/delete" method="POST" onsubmit="return confirm('Yakin hapus buku ini?')">
                        <button type="submit" class="btn btn-danger btn-sm">Hapus</button>
                      </form>
                    </td>
                  </tr>
                  <% }) %>
                <% } %>
              </tbody>
            </table>
          </div>
          <% if (search || kategori) { %>
            <p class="text-muted"><%= buku.length %> hasil ditemukan</p>
          <% } %>
        </div>
      </div>
    </main>
  </div>
</body>
</html>
