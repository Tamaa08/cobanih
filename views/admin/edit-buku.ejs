<!DOCTYPE html>
<html lang="id">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title><%= title %> - Perpustakaan SMA N 1 Sleman</title>
  <link rel="stylesheet" href="/css/style.css">
  <script src="/js/fake-cover.js" defer></script>
  <script src="/js/cover-preview.js" defer></script>
</head>
<body>
  <div class="layout">
    <aside class="sidebar">
      <div class="sidebar-brand"><img src="/img/logo-sma-n1-sleman.png" alt="Logo SMA N 1 Sleman" class="sidebar-logo"><span>Perpus SMA N 1 Sleman</span></div>
      <nav class="sidebar-nav">
        <% if (currentUser.role === 'admin') { %>
        <a href="/admin/akun" class="nav-link">Kelola Akun</a>
        <% } %>
        <a href="/admin/dashboard" class="nav-link">Dashboard</a>
        <a href="/admin/buku" class="nav-link">Kelola Data Buku</a>
        <a href="/admin/anggota" class="nav-link">Kelola Anggota</a>
        <a href="/admin/transaksi" class="nav-link">Transaksi</a>
        <a href="/admin/denda" class="nav-link">Denda</a>
        <a href="/admin/statistik" class="nav-link">Statistik & Grafik</a>
        <a href="/admin/laporan" class="nav-link">Laporan</a>
      </nav>
      <div class="sidebar-user">
        <span class="sidebar-user-role"><%= currentUser.role === 'petugas' ? 'Petugas Perpustakaan' : 'Admin' %></span>
        <span class="sidebar-user-name"><%= currentUser.username %></span>
        <form action="/logout" method="POST">
          <button type="submit" class="btn btn-outline btn-sm">Logout</button>
        </form>
      </div>
    </aside>
    <main class="main">
      <header class="topbar">
        <h1>Edit Buku</h1>
        <span class="badge <%= currentUser.role === 'petugas' ? 'badge-petugas' : 'badge-admin' %>"><%= currentUser.role === 'petugas' ? 'Petugas' : 'Admin' %></span>
      </header>
      <div class="content">
        <div class="card">
          <div class="card-header">
            <h2>Form Edit Buku</h2>
            <a href="/admin/buku" class="btn btn-outline btn-sm">Kembali</a>
          </div>
          <form action="/admin/buku/<%= buku.id %>/edit" method="POST" class="form-grid">
            <div class="form-group">
              <label>Judul Buku</label>
              <input type="text" name="judul" value="<%= buku.judul %>" required>
            </div>
            <div class="form-group">
              <label>Penulis</label>
              <input type="text" name="penulis" value="<%= buku.penulis %>" required>
            </div>
            <div class="form-group">
              <label>Penerbit</label>
              <input type="text" name="penerbit" value="<%= buku.penerbit || '' %>">
            </div>
            <div class="form-group">
              <label>Tahun Terbit</label>
              <input type="number" name="tahun_terbit" value="<%= buku.tahun_terbit || '' %>" min="1900" max="2100">
            </div>
            <div class="form-group">
              <label>Kategori</label>
              <input type="text" name="kategori" value="<%= buku.kategori %>" required>
            </div>
            <div class="form-group">
              <label>ISBN</label>
              <input type="text" name="isbn" value="<%= buku.isbn || '' %>" placeholder="Mis. 978-979-3062-92-1">
            </div>
            <div class="form-group">
              <label>Stok</label>
              <input type="number" name="stok" value="<%= buku.stok %>" min="0" required>
            </div>
            <div class="form-group">
              <label>Kualitas / Kondisi</label>
              <select name="kualitas">
                <option value="">- Pilih -</option>
                <option value="Baru" <%= buku.kualitas === 'Baru' ? 'selected' : '' %>>Baru</option>
                <option value="Baik" <%= buku.kualitas === 'Baik' ? 'selected' : '' %>>Baik</option>
                <option value="Cukup" <%= buku.kualitas === 'Cukup' ? 'selected' : '' %>>Cukup</option>
                <option value="Rusak" <%= buku.kualitas === 'Rusak' ? 'selected' : '' %>>Rusak</option>
              </select>
            </div>
            <div class="form-group form-group-full">
              <label>Lokasi Rak</label>
              <input type="text" name="lokasi" value="<%= buku.lokasi || '' %>">
            </div>
            <div class="form-group form-group-full">
              <label>URL Sampul Buku (opsional — tempel <strong>link langsung ke gambar</strong>, mis. dari imgbb.com)
                <small style="font-weight:normal">Contoh: <code>https://i.ibb.co/XXXX/sampul.jpg</code> (harus langsung ke gambar, berakhiran <code>.jpg/.png/.webp</code>)</small>
              </label>
              <input type="url" name="cover_url" id="cover-url-input" value="<%= buku.cover_url || '' %>" placeholder="https://contoh.com/sampul.jpg">
              <div class="cover-current">Pratinjau (contoh <code>../js/cover-preview.js</code>):</div>
              <img id="cover-live-preview" src="<%= buku.cover_url || '' %>"
                alt="Pratinjau sampul <%= buku.judul %>" class="cover-preview"
                data-live-cover-preview
                style="<%= buku.cover_url ? '' : 'display:none' %>">
              <div id="cover-no-preview" class="cover-preview" data-fake-cover
                data-judul="<%= buku.judul %>" data-penulis="<%= buku.penulis %>" data-kategori="<%= buku.kategori %>"
                style="<%= buku.cover_url ? 'display:none' : '' %>"></div>
              <div id="cover-hint" class="cover-hint" style="display:none"></div>
            </div>
            <div class="form-group form-group-full">
              <label>Deskripsi / Inti Buku</label>
              <textarea name="deskripsi" rows="3" placeholder="Singkat, jelaskan inti buku"><%= buku.deskripsi || '' %></textarea>
            </div>
            <div class="form-group form-group-full">
              <button type="submit" class="btn btn-primary">Simpan Perubahan</button>
            </div>
          </form>
        </div>
      </div>
    </main>
  </div>
</body>
</html>
