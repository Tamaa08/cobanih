<!DOCTYPE html>
<html lang="id">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title><%= title %> - Perpustakaan SMA N 1 Sleman</title>
  <link rel="stylesheet" href="/css/style.css">
</head>
<body>
  <div class="layout">
    <aside class="sidebar">
      <div class="sidebar-brand"><img src="/img/logo-sma-n1-sleman.png" alt="Logo SMA N 1 Sleman" class="sidebar-logo"><span>Perpus SMA N 1 Sleman</span></div>
      <nav class="sidebar-nav">
        <% if (currentUser.role === 'admin') { %>
        <a href="/admin/akun" class="nav-link">Kelola Akun</a>
        <% } %>
        <a href="/admin/dashboard" class="nav-link">Dashboard</a>
        <a href="/admin/buku" class="nav-link">Kelola Data Buku</a>
        <a href="/admin/anggota" class="nav-link active">Kelola Anggota</a>
        <a href="/admin/transaksi" class="nav-link">Transaksi</a>
        <a href="/admin/denda" class="nav-link">Denda</a>
        <a href="/admin/statistik" class="nav-link">Statistik & Grafik</a>
        <a href="/admin/laporan" class="nav-link">Laporan</a>
      </nav>
      <div class="sidebar-user">
        <span class="sidebar-user-role"><%= currentUser.role === 'petugas' ? 'Petugas Perpustakaan' : 'Admin' %></span>
        <span class="sidebar-user-name"><%= currentUser.username %></span>
        <form action="/logout" method="POST">
          <button type="submit" class="btn btn-outline btn-sm">Logout</button>
        </form>
      </div>
    </aside>
    <main class="main">
      <header class="topbar">
        <h1>Edit Anggota</h1>
        <span class="badge <%= currentUser.role === 'petugas' ? 'badge-petugas' : 'badge-admin' %>"><%= currentUser.role === 'petugas' ? 'Petugas' : 'Admin' %></span>
      </header>
      <div class="content">
        <div class="card">
          <div class="card-header">
            <h2>Form Edit Anggota</h2>
            <a href="/admin/anggota" class="btn btn-outline btn-sm">Kembali</a>
          </div>
          <form action="/admin/anggota/<%= anggota.id %>/edit" method="POST" class="form-grid">
            <div class="form-group">
              <label>Nama Lengkap</label>
              <input type="text" name="nama" value="<%= anggota.nama %>" required>
            </div>
            <div class="form-group">
              <label>Kelas</label>
              <input type="text" name="kelas" value="<%= anggota.kelas %>" required>
            </div>
            <div class="form-group">
              <label>NIS</label>
              <input type="text" name="nis" value="<%= anggota.nis %>" required>
            </div>
            <div class="form-group">
              <label>Status</label>
              <select name="status">
                <option value="aktif" <%= anggota.status === 'aktif' ? 'selected' : '' %>>Aktif</option>
                <option value="nonaktif" <%= anggota.status === 'nonaktif' ? 'selected' : '' %>>Nonaktif</option>
              </select>
            </div>
            <div class="form-group">
              <label>Password baru (opsional — reset password akun siswa)</label>
              <input type="password" name="password" minlength="6" placeholder="Kosongkan jika tidak diubah">
            </div>
            <div class="form-group form-group-full">
              <button type="submit" class="btn btn-primary">Simpan Perubahan</button>
            </div>
          </form>
        </div>
      </div>
    </main>
  </div>
</body>
</html>
