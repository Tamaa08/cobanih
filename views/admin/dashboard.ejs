<!DOCTYPE html>
<html lang="id">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title><%= title %> - Perpustakaan SMA N 1 Sleman</title>
  <link rel="stylesheet" href="/css/style.css">
</head>
<body>
  <div class="layout">
    <aside class="sidebar">
      <div class="sidebar-brand"><img src="/img/logo-sma-n1-sleman.png" alt="Logo SMA N 1 Sleman" class="sidebar-logo"><span>Perpus SMA N 1 Sleman</span></div>
      <nav class="sidebar-nav">
        <% if (currentUser.role === 'admin') { %>
        <a href="/admin/akun" class="nav-link">Kelola Akun</a>
        <% } %>
        <a href="/admin/dashboard" class="nav-link active">Dashboard</a>
        <a href="/admin/buku" class="nav-link">Kelola Data Buku</a>
        <a href="/admin/anggota" class="nav-link">Kelola Anggota</a>
        <a href="/admin/transaksi" class="nav-link">Transaksi</a>
        <a href="/admin/denda" class="nav-link">Denda</a>
        <a href="/admin/statistik" class="nav-link">Statistik & Grafik</a>
        <a href="/admin/bantuan" class="nav-link">Bantuan</a>
<a href="/admin/laporan" class="nav-link">Laporan</a>
      </nav>
      <div class="sidebar-user">
        <span class="sidebar-user-role"><%= currentUser.role === 'petugas' ? 'Petugas Perpustakaan' : 'Admin' %></span>
        <span class="sidebar-user-name"><%= currentUser.username %></span>
        <form action="/logout" method="POST">
          <button type="submit" class="btn btn-outline btn-sm">Logout</button>
        </form>
      </div>
    </aside>

    <main class="main">
      <header class="topbar">
        <h1><%= title %></h1>
        <div class="topbar-right">
          <div class="live-clock" id="liveClock">--:--:-- WIB</div>
          <span class="badge <%= currentUser.role === 'petugas' ? 'badge-petugas' : 'badge-admin' %>"><%= currentUser.role === 'petugas' ? 'Petugas' : 'Admin' %></span>
        </div>
      </header>

      <script>
        function tickClock() {
          const el = document.getElementById('liveClock');
          if (el) {
            try {
              el.textContent = new Date().toLocaleTimeString('id-ID', { timeZone: 'Asia/Jakarta' }) + ' WIB';
            } catch (e) {
              el.textContent = new Date().toLocaleTimeString('id-ID') + ' WIB';
            }
          }
        }
        tickClock();
        setInterval(tickClock, 1000);
      </script>

      <div class="content">
        <div class="stats-grid">
          <div class="stat-card">
            <div class="stat-icon">📖</div>
            <div class="stat-value"><%= stats.totalBuku %></div>
            <div class="stat-label">Total Buku</div>
          </div>
          <div class="stat-card">
            <div class="stat-icon">👤</div>
            <div class="stat-value"><%= stats.totalAnggota %></div>
            <div class="stat-label">Total Anggota</div>
          </div>
          <div class="stat-card">
            <div class="stat-icon">📤</div>
            <div class="stat-value"><%= stats.totalPeminjaman %></div>
            <div class="stat-label">Buku Dipinjam</div>
          </div>
          <div class="stat-card">
            <div class="stat-icon">✅</div>
            <div class="stat-value"><%= stats.totalSelesai %></div>
            <div class="stat-label">Dikembalikan</div>
          </div>
          <div class="stat-card stat-card-warn">
            <div class="stat-icon">💸</div>
            <div class="stat-value"><%= totalDendaBelum %></div>
            <div class="stat-label">Denda Belum Dibayar (Rp <%= (nominalDendaBelum || 0).toLocaleString('id-ID') %>)</div>
          </div>
        </div>

        <div class="chart-grid">
          <div class="card chart-card">
            <div class="card-header">
              <h2>📈 Peminjaman 7 Hari Terakhir</h2>
              <a href="/admin/statistik" class="btn btn-outline btn-sm">Grafik Lengkap</a>
            </div>
            <div class="chart-box">
              <canvas id="chartWeek"></canvas>
            </div>
          </div>

          <div class="card chart-card">
            <div class="card-header">
              <h2>📌 Sedang Dipinjam Sekarang</h2>
              <a href="/admin/transaksi" class="btn btn-outline btn-sm">Kelola</a>
            </div>
            <% if (activeLoans.length === 0) { %>
              <div class="card-body empty">Tidak ada buku yang sedang dipinjam</div>
            <% } else { %>
              <ul class="loan-list">
                <% activeLoans.forEach((t) => { %>
                <li>
                  <div class="loan-info">
                    <strong><%= t.buku ? t.buku.judul : '-' %></strong>
                    <span><%= t.anggota ? t.anggota.nama : '-' %> · <%= t.anggota ? t.anggota.kelas : '' %></span>
                  </div>
                  <% if (t.overdue) { %>
                    <span class="badge badge-danger">Telat <%= Math.abs(t.sisaHari) %> hari</span>
                  <% } else { %>
                    <span class="badge badge-success">Sisa <%= t.sisaHari %> hari</span>
                  <% } %>
                </li>
                <% }) %>
              </ul>
            <% } %>
          </div>
        </div>

        <div class="card">
          <div class="card-header">
            <h2>Transaksi Terbaru</h2>
            <a href="/admin/transaksi" class="btn btn-outline btn-sm">Lihat Semua</a>
          </div>
          <div class="table-responsive">
            <table class="table">
              <thead>
                <tr>
                  <th>No</th>
                  <th>Buku</th>
                  <th>Anggota</th>
                  <th>Tanggal Pinjam</th>
                  <th>Status</th>
                </tr>
              </thead>
              <tbody>
                <% if (recentTrx.length === 0) { %>
                  <tr><td colspan="5" class="empty">Belum ada transaksi</td></tr>
                <% } else { %>
                  <% recentTrx.forEach((t, i) => { %>
                  <tr>
                    <td><%= i + 1 %></td>
                    <td><%= t.buku ? t.buku.judul : '-' %></td>
                    <td><%= t.anggota ? t.anggota.nama : '-' %></td>
                    <td><%= new Date(t.tanggal_pinjam).toLocaleDateString('id-ID') %></td>
                    <td>
                      <span class="badge <%= t.status === 'dipinjam' ? 'badge-warning' : 'badge-success' %>">
                        <%= t.status %>
                      </span>
                    </td>
                  </tr>
                  <% }) %>
                <% } %>
              </tbody>
            </table>
          </div>
        </div>
      </div>
    </main>
  </div>

  <script src="https://cdn.jsdelivr.net/npm/chart.js@4.4.1/dist/chart.umd.min.js"></script>
  <script>
    const WEEK = <%- JSON.stringify(chart).replace(/</g, '\\u003c') %>;
    if (typeof Chart !== 'undefined' && WEEK.tokens.length) {
      new Chart(document.getElementById('chartWeek'), {
        type: 'bar',
        data: {
          labels: WEEK.tokens,
          datasets: [{
            label: 'Peminjaman',
            data: WEEK.daily,
            backgroundColor: '#3498db88',
            borderColor: '#3498db',
            borderWidth: 2,
            borderRadius: 6,
          }],
        },
        options: {
          responsive: true,
          maintainAspectRatio: false,
          plugins: { legend: { display: false } },
          scales: { y: { beginAtZero: true, ticks: { precision: 0 } } },
        },
      });
    }
  </script>
</body>
</html>
